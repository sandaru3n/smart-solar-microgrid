# Copy this file to .env and fill in real values.
# Never commit .env. It is listed in .gitignore.

# MongoDB (must be a replica set, e.g. Atlas, because reservations use transactions)
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>/
MONGODB_DATABASE_NAME=<database-name>

# JWT signing key (Member 1)
JWT_SECRET=<long-random-secret>

# QR signing key for transaction QR codes (Member 4).
# At least 32 characters. Generate one with:
#   PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Bash:       openssl rand -base64 48
QR_SECRET_KEY=<long-random-secret-at-least-32-characters>

# QR validity window, in minutes.
# A scan is accepted from (slot start - BEFORE) until (slot end + AFTER).
QR_VALID_BEFORE_START_MINUTES=120
QR_VALID_AFTER_END_MINUTES=0

# SMTP for outgoing email (OTP, account and booking approve/reject notices).
# For Gmail, use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-app-password>
SMTP_FROM_EMAIL=<from-address>
SMTP_FROM_NAME=Smart Solar Microgrid

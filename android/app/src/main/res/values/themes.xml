<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SolarGrid" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/solar_yellow</item>
        <item name="colorPrimaryVariant">@color/solar_yellow_dark</item>
        <item name="colorOnPrimary">@color/dashboard_text</item>
        <item name="colorSecondary">@color/solar_yellow</item>
        <item name="colorOnSecondary">@color/dashboard_text</item>
        <item name="android:statusBarColor">@color/solarix_header</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialAlertDialogTheme">@style/Theme.SolarGrid.AlertDialog</item>
    </style>

    <style name="Theme.SolarGrid.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.SolarGrid.Dialog</item>
    </style>

    <style name="ShapeAppearance.SolarGrid.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Plain yellow window only — do not use Theme.SplashScreen animated icon (forces monochrome icon). -->
    <style name="Theme.SolarGrid.Splash" parent="Theme.SolarGrid">
        <item name="android:windowBackground">@color/solarix_splash</item>
        <item name="android:statusBarColor">@color/solarix_splash</item>
        <item name="android:navigationBarColor">@color/solarix_splash</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Material Components theme used only by the Grid Operator screens. -->
    <style name="Theme.SolarGrid.Operator" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/op_primary</item>
        <item name="colorPrimaryVariant">@color/op_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/op_accent</item>
        <item name="colorSecondaryVariant">@color/op_amber_fg</item>
        <item name="colorOnSecondary">@color/op_text</item>
        <item name="colorSurface">@color/op_surface</item>
        <item name="colorOnSurface">@color/op_text</item>
        <item name="android:colorBackground">@color/op_background</item>
        <item name="android:windowBackground">@color/op_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/op_background</item>
    </style>

    <style name="OperatorCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/op_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/op_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="OperatorSectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/op_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <!-- Filter chips on the operator list screens: dark when selected, outlined otherwise. -->
    <style name="OperatorFilterChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/op_chip_bg</item>
        <item name="chipStrokeColor">@color/op_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/op_chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="rippleColor">@color/op_header_chip</item>
    </style>

    <!-- Small pill for statuses and specs (tinted in code via OperatorScreen.applyChip). -->
    <style name="OperatorPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_operator_role_chip</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="OperatorTopBarTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- Ignored below API 28, where TalkBack has no heading navigation anyway. -->
        <item name="android:accessibilityHeading" tools:targetApi="p">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/op_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- One booked energy slot with its fill level. Bound in OperatorStationDetailActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/op_text"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="10:00 AM – 11:00 AM" />

        <TextView
            android:id="@+id/tvState"
            style="@style/OperatorPill"
            tools:text="2 left" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/fill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:max="100"
        app:trackCornerRadius="4dp"
        app:trackThickness="6dp"
        tools:progress="60" />

    <TextView
        android:id="@+id/tvBooked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/op_text_secondary"
        android:textSize="12sp"
        tools:text="3 of 5 booked" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- One station on the operator Stations list. Bound in OperatorStationAdapter. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/OperatorCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/iconBadge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_operator_icon_badge"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_op_station" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/op_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Colombo Solar Hub" />

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/op_text_secondary"
                android:textSize="13sp"
                tools:text="12 Galle Road, Colombo 03" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCapacity"
                    style="@style/OperatorPill"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_op_sun_small"
                    app:drawableTint="@color/op_yellow_fg"
                    tools:text="120 kW" />

                <TextView
                    android:id="@+id/tvBattery"
                    style="@style/OperatorPill"
                    android:layout_marginStart="8dp"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_op_battery_small"
                    app:drawableTint="@color/op_blue_fg"
                    tools:text="8 battery slots" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_op_chevron_right"
            app:tint="@color/op_text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
